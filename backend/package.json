{
  "name": "pulso-urbano",
  "version": "1.0.0",
  "description": "**Pulso Urbano** é uma plataforma digital de dados, análises e previsões desenvolvida em parceria com o [CRISP/UFMG](https://www.crisp.ufmg.br), com o objetivo de tornar acessível o conhecimento produzido em pesquisas acadêmicas e sociais sobre segurança pública, criminalidade, juventude e urbanismo.",
  "main": "src/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "db:local:up": "docker compose -f ../database/docker-compose.yml up -d",
    "db:local:setup": "tsx scripts/setup_local_db.ts",
    "storage:cors": "tsx scripts/configure_r2_cors.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitimizacaocrisp/Pulso-Urbano.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vitimizacaocrisp/Pulso-Urbano/issues"
  },
  "homepage": "https://github.com/vitimizacaocrisp/Pulso-Urbano#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@neondatabase/serverless": "^1.0.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.5",
    "speakeasy": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/speakeasy": "^2.0.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
