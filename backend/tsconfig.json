{
  "compilerOptions": {
    // Saída CommonJS (package.json sem "type": "module"): é o formato que o
    // runtime Node da Vercel carrega sem surpresas. `nodenext` mantém os
    // imports relativos sem extensão, como sempre foram no projeto.
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    // Explícitos de propósito: o build da Vercel (@vercel/express) type-checa com um
    // tsconfig temporário que estende este; sem typeRoots relativo ao projeto ele
    // não acha @types/* e o deploy falha com erros de tipo.
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "strict": true,
    // catch (e) segue tipado como any (como no JS original) — evita ~20 casts
    // sem valor; erros tratados por mensagem/código continuam funcionando.
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
