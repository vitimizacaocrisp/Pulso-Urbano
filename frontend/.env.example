# API base URL. Frontend e backend são projetos Vercel separados (domínios
# diferentes) — sempre cross-origin. Em dev, vazio usa o proxy do Nuxt
# (nuxt.config.ts → vite.server.proxy) apontando pra http://localhost:3000.
NUXT_PUBLIC_API_URL=

# EmailJS — usado pelo formulário da página de Contato (pages/contato.vue).
# Crie uma conta em https://www.emailjs.com e configure:
#   1. Um Email Service  → copie o Service ID
#   2. Um Email Template  → copie o Template ID
#        (use as variáveis: {{from_name}}, {{reply_to}}, {{subject}}, {{message}})
#   3. Account → API Keys → copie a Public Key
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Vídeo institucional (pitch) exibido na página Sobre — aceita link do
# YouTube ou Vimeo. A seção fica oculta automaticamente enquanto vazio.
NUXT_PUBLIC_PITCH_VIDEO_URL=
